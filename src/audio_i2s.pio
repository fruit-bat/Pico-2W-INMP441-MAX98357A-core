; =====================================================================
; I2S TX/RX program.
; GPIO11 = SD (data input)
; GPIO13 = BCLK (side-set bit 0)
; GPIO14 = WS   (side-set bit 1)
; GPIO12 = DIN
;
; Standard I2S uses WS low for the left word and WS high for the right word.
; The side-set value is encoded as [BCLK, WS], so 0b00 = low/low,
; 0b01 = high/low, 0b10 = low/high, 0b11 = high/high.
; =====================================================================
.program audio_i2s_tx
.side_set 2 opt

public entry_point:
                    ;        /--- LRCLK
                    ;        |/-- BCLK
    set x, 0          side 0b00 [1]
    set y, 30         side 0b01 [1] ; start of Left frame

.wrap_target
; Everything should change on the falling edge

dataL:
    out pins, 1       side 0b00 [1] ; change on falling edge
    in pins, 1        side 0b01     ; sample on rising edge
    jmp y-- dataL     side 0b01 
    out pins, 1       side 0b10 [1] ; change on falling edge
    in pins, 1        side 0b11     ; sample on rising edge
    set y, 30         side 0b11 
dataR:
    nop               side 0b10 [1] ; change on falling edge
    nop               side 0b11     ; sample on rising edge
    jmp y-- dataR     side 0b11 
    nop               side 0b00 [1] ; change on falling edge
    nop               side 0b01     ; sample on rising edge
    set y, 30         side 0b01
