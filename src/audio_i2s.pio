; =====================================================================
; I2S TX (Transmit) Program - Generates BCLK and WS, outputs data
; =====================================================================
.program audio_i2s_tx
.side_set 2

; Side-set bit 0: BCLK
; Side-set bit 1: WS (0 = Left, 1 = Right)

public entry_point:
    set x, 30          side 0b10  ; Pre-load bit counter (32 bits per channel minus 2)
left_loop:
    out pins, 1        side 0b00  ; Shift 1 data bit out, drive BCLK low, WS low (Left)
    jmp x-- left_loop  side 0b01  ; Drive BCLK high, loop back for next bit
    
    out pins, 1        side 0b00  ; Shift last left data bit out, BCLK low, WS low
    set x, 30          side 0b11  ; Drive BCLK high, WS high (Switching to Right)

right_loop:
    out pins, 1        side 0b01  ; Shift 1 data bit out, drive BCLK low, WS high (Right)
    jmp x-- right_loop side 0b11  ; Drive BCLK high, loop back for next bit
    
    out pins, 1        side 0b01  ; Shift last right data bit out, BCLK low, WS high
    jmp entry_point    side 0b10  ; Drive BCLK high, flip WS back to low, restart frame


; =====================================================================
; I2S RX (Receive) Program - Syncs to external BCLK/WS, samples data
; =====================================================================
.program audio_i2s_rx

; Input pins: pin 0 = BCLK, pin 1 = WS, pin 2 = SD (Serial Data Input)

public entry_point:
    wait 0 pin 1         ; Wait for WS to drop low (Start of Left channel frame)
    set x, 31            ; Prepare to read 32 bits of audio data
    
left_sample:
    wait 1 pin 0         ; Wait for BCLK rising edge (Data is stable here)
    in pins, 1           ; Sample 1 bit from the SD data input pin
    wait 0 pin 0         ; Wait for BCLK falling edge
    jmp x-- left_sample  ; Loop until all 32 bits are shifted into the RX FIFO

    wait 1 pin 1         ; Wait for WS to go high (Start of Right channel frame)
    set x, 31            ; Prepare to read 32 bits
    
right_sample:
    wait 1 pin 0         ; Wait for BCLK rising edge
    in pins, 1           ; Sample 1 bit (or discard if using strict Left-only mono)
    wait 0 pin 0         ; Wait for BCLK falling edge
    jmp x-- right_sample ; Loop until 32 bits read, then circle back to entry_point
